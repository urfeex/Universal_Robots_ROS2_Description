<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="rviz_config_file" default="$(find-pkg-share ur_description)/rviz/view_robot.rviz" />
  <arg name="description_file" default="$(find-pkg-share ur_description)/urdf/ur.urdf.xacro" />
  <arg name="ur_type"/>

  <let name="robot_description_content"
       value="$(command '$(find-exec xacro) $(var description_file) ur_type:=$(var ur_type) name:=ur')"/>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />
  <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_file)" />
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(var robot_description_content)"/>
  </node>
</launch>
